FLOWFORGE_DB=flowforge.db
FLOWFORGE_API_KEY=            # optional: require X-API-Key on every endpoint except webhooks
FLOWFORGE_ALLOW_PRIVATE=1     # demo only: lets HTTP nodes call localhost (SSRF guard is ON when unset)
ANTHROPIC_API_KEY=            # optional: AI Step node + LLM workflow generation (offline fallback otherwise)
FLOWFORGE_SMTP_HOST=          # optional: real email; otherwise emails go to GET /outbox
